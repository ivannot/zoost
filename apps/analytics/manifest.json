{
  "manifest_version": 3,
  "name": "Zoost — workbench for Zoho Analytics",
  "version": "0.9.3",
  "short_name": "Zoost Analytics",
  "homepage_url": "https://zoost.it",
  "description": "Independent workbench for Zoho Analytics: census every view in a workspace, when each last changed, and what nothing depends on.",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://analytics.zoho.eu/*",
    "https://analytics.zoho.com/*",
    "https://analytics.zoho.in/*",
    "https://analytics.zoho.com.au/*",
    "https://analytics.zoho.jp/*",
    "https://analytics.zohocloud.ca/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Zoost — workbench for Zoho Analytics",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://analytics.zoho.eu/*",
        "https://analytics.zoho.com/*",
        "https://analytics.zoho.in/*",
        "https://analytics.zoho.com.au/*",
        "https://analytics.zoho.jp/*",
        "https://analytics.zohocloud.ca/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
