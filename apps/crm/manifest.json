{
  "manifest_version": 3,
  "name": "Zoost - workbench for Zoho CRM",
  "version": "1.39.0",
  "short_name": "Zoost CRM",
  "homepage_url": "https://zoost.it",
  "description": "Independent, unofficial: mirror your Zoho CRM Deluge to local files for Git, plus the call graph, module schema and workflows.",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; form-action 'none'"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://crm.zoho.eu/*",
    "https://crm.zoho.com/*",
    "https://crm.zoho.in/*",
    "https://crm.zoho.com.au/*",
    "https://crm.zoho.jp/*",
    "https://crm.zohocloud.ca/*",
    "https://crm.zoho.sa/*",
    "https://crm.zoho.uk/*",
    "https://crm.zoho.ae/*",
    "https://crmsandbox.zoho.eu/*",
    "https://crmsandbox.zoho.com/*",
    "https://crmsandbox.zoho.in/*",
    "https://crmsandbox.zoho.com.au/*",
    "https://crmsandbox.zoho.jp/*",
    "https://crmsandbox.zohocloud.ca/*",
    "https://crmsandbox.zoho.sa/*",
    "https://crmsandbox.zoho.uk/*",
    "https://crmsandbox.zoho.ae/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://one.zoho.eu/*",
    "https://one.zoho.com/*",
    "https://one.zoho.in/*",
    "https://one.zoho.com.au/*",
    "https://one.zoho.jp/*",
    "https://one.zohocloud.ca/*",
    "https://one.zoho.sa/*",
    "https://one.zoho.uk/*",
    "https://one.zoho.ae/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Zoost - workbench for Zoho CRM",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://crm.zoho.eu/*",
        "https://crm.zoho.com/*",
        "https://crm.zoho.in/*",
        "https://crm.zoho.com.au/*",
        "https://crm.zoho.jp/*",
        "https://crm.zohocloud.ca/*",
        "https://crm.zoho.sa/*",
        "https://crm.zoho.uk/*",
        "https://crm.zoho.ae/*",
        "https://crmsandbox.zoho.eu/*",
        "https://crmsandbox.zoho.com/*",
        "https://crmsandbox.zoho.in/*",
        "https://crmsandbox.zoho.com.au/*",
        "https://crmsandbox.zoho.jp/*",
        "https://crmsandbox.zohocloud.ca/*",
        "https://crmsandbox.zoho.sa/*",
        "https://crmsandbox.zoho.uk/*",
        "https://crmsandbox.zoho.ae/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://crm.zoho.eu/*",
        "https://crm.zoho.com/*",
        "https://crm.zoho.in/*",
        "https://crm.zoho.com.au/*",
        "https://crm.zoho.jp/*",
        "https://crm.zohocloud.ca/*",
        "https://crm.zoho.sa/*",
        "https://crm.zoho.uk/*",
        "https://crm.zoho.ae/*",
        "https://crmsandbox.zoho.eu/*",
        "https://crmsandbox.zoho.com/*",
        "https://crmsandbox.zoho.in/*",
        "https://crmsandbox.zoho.com.au/*",
        "https://crmsandbox.zoho.jp/*",
        "https://crmsandbox.zohocloud.ca/*",
        "https://crmsandbox.zoho.sa/*",
        "https://crmsandbox.zoho.uk/*",
        "https://crmsandbox.zoho.ae/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ]
}
