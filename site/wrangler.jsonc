{
  // zoost.it — a Worker that serves this directory as static assets, plus one endpoint.
  //
  // Cloudflare's git integration deploys with "Root directory: site", so this config lives here and
  // every path below is relative to site/. Until now no config was committed and Cloudflare used a
  // generated one; this file reproduces it exactly and adds only `main` and the assets binding, so
  // nothing about how the site is served changes. `compatibility_flags` and `observability` are
  // carried over deliberately — dropping them would quietly alter the runtime.
  //
  // Assets are served first: the script in `main` runs only when no file matches, which is why
  // adding it cannot affect any existing page. `.assetsignore` keeps this file and the script from
  // being published (the generated config is currently readable at /wrangler.jsonc; it will not be).
  "name": "zoost-it",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "main": "_worker.js",
  // When this Worker was deployed, from the runtime rather than from anything anyone types. The
  // footer used to date the site by the newest commit touching `site/`, which is a *proxy*: a commit
  // exists whether or not a build ever ran, and this project has already had a fortnight of pushes
  // that never deployed (see the build-watch-paths note in CLAUDE.md). This binding costs no API
  // token and no request - it is this version's own creation time, handed to the script.
  "version_metadata": { "binding": "CF_VERSION" },
  // What the Chrome Web Store is serving, written every half hour by the `store status` workflow and
  // read here. It is deliberately *not* a file in this directory: anything under site/ is a build
  // watch path, so committing the reading redeployed the whole site whenever Google moved a number -
  // and `CF_VERSION.timestamp` above is that deploy's own time, so the footer would have announced
  // the site updated because a version somewhere else changed. Same defect this project already
  // fixed once for `lastChanged('site')`, arriving by a different door.
  //
  // The ids are out of a dashboard URL and are not secrets, exactly like the publisher id in
  // `_worker.js`. The credential is a GitHub secret scoped to Workers KV Storage, and it stays there:
  // nothing web-facing can write this.
  "kv_namespaces": [
    { "binding": "STATUS", "id": "7bccd32413744db3a7cf9d90c9396bc7" }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Assets win by default, so the script never saw /llms.txt and the charset it sets was dead code:
    // the file went out as `text/plain` with no encoding, the browser guessed Windows-1252, and every
    // em-dash rendered as `â€”` — the reported bug, still live after being called fixed on the wrong
    // evidence (the bytes were always correct; the header was the whole problem). Only these paths
    // run the script first; everything else is served exactly as before. sitecheck.py asserts that
    // every .txt in this directory is listed here, so the list cannot fall behind the files.
    // A request that matches no asset is rewritten to 404.html and served as a real 404, instead of
    // landing on Cloudflare's own error page - which has none of this site's chrome and no way back.
    "not_found_handling": "404-page",
    // ...but `not_found_handling` stops navigation requests from invoking the Worker at all, and the
    // Worker is what 301s `/docs` and `/docs.html`. **`zoost.it/docs.html` is compiled into Zoost for
    // Zoho CRM 1.9.0**, the version the Store is serving, so those two must keep redirecting: they run
    // the script first and the 404 stays the fallback for everything else.
    "run_worker_first": ["/api/*", "/llms.txt", "/robots.txt", "/docs", "/docs.html"]
  }
}
